{
	// ---- paths into this repo (macOS, Desktop/cp) ----
	"contests_base": "/Users/sakibkhan/Desktop/cp/contests",
	"algorithms_base": "/Users/sakibkhan/Desktop/cp/library",

	// enable/disable lint
	"lint_enabled": true,
	"lint_error_region_scope": "invalid.illegal",
	"lint_warning_region_scope": "constant",

	// run settings:
	// "{file}": file name
	// "{source_file}": relative path to file
	// "{source_file_dir}": relative path to file directory
	// "{file_name}": file basename
	"run_settings": [
		{
			"name": "C++",
			"extensions": ["cpp"],

			// macOS: plain g++ is Apple Clang here (no <bits/stdc++.h>), so this
			// points at the real GCC installed via `brew install gcc`.
			"compile_cmd": "/opt/homebrew/bin/g++-16 \"{source_file}\" -std=gnu++20 -O2 -Wall -Wextra -Wshadow -DLOCAL -o \"{file_name}\"",
			"run_cmd": "./\"{file_name}\"",
			"lint_compile_cmd": "/opt/homebrew/bin/g++-16 -std=gnu++20 -DLOCAL -fsyntax-only -Wall -Wextra \"{source_file}\" -I \"{source_file_dir}\""
		},
		{
			"name": "Python",
			"extensions": ["py"],
			"compile_cmd": null,
			"run_cmd": "python3 \"{source_file}\""
		},
		{
			"name": "Java",
			"extensions": ["java"],
			"compile_cmd": "javac -J-Dfile.encoding=utf8 -d \"{source_file_dir}\" \"{source_file}\"",
			"run_cmd": "java -classpath \"{source_file_dir}\" \"{file_name}\""
		}
	],

	// time limit for stress
	"stress_time_limit_seconds": 2,

	// keep test data in a tests/ subfolder instead of beside the .cpp
	"tests_relative_dir": "tests",

	// closing sidebar when executing
	"close_sidebar": true,

	// enable/disable class complete
	"cpp_complete_enabled": true,
	"cpp_complete_settings": {
		"classes": {
			"int": { "template_size": 0 },
			"char": { "template_size": 0 },
			"bool": { "template_size": 0 },
			"double": { "template_size": 0 },
			"string": { "template_size": 0 },
			"ll": { "template_size": 0 },
			"pair": { "template_size": 2 },
			"vector": { "template_size": 1 },
			"set": { "template_size": 1, "bind": "S" },
			"map": { "template_size": 2 }
		},
		"dont_expand": ["pii", "pll", "ull"]
	}
}
