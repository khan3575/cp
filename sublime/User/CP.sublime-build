{
    "selector": "source.c++, source.cpp",
    "working_dir": "$file_path",
    "file_regex": "^(..[^:\n]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "encoding": "utf-8",
    "syntax": "Packages/Text/Plain text.tmLanguage",

    // Linux and macOS share scripts/run.sh (compiler detection + every flag live there).
    // $packages/User is a symlink to <repo>/sublime/User, so ../../scripts is the repo's scripts/.
    "windows": { "shell_cmd": "g++ -std=gnu++20 -O2 -pipe -Wall -Wextra -Wshadow -DLOCAL -Wl,--stack=268435456 -o \"$file_base_name.exe\" \"$file\" && \"$file_base_name.exe\" < input.txt" },
    "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" run \"$file\"" },
    "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" run \"$file\"" },

    "variants": [
        {
            "name": "Compile only",
            "windows": { "shell_cmd": "g++ -std=gnu++20 -O2 -Wall -Wextra -Wshadow -DLOCAL -o \"$file_base_name.exe\" \"$file\"" },
            "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" compile \"$file\"" },
            "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" compile \"$file\"" }
        },
        {
            "name": "Debug (checked build)",
            "windows": { "shell_cmd": "g++ -std=gnu++20 -O0 -g -Wall -Wextra -Wshadow -Wconversion -DLOCAL -D_GLIBCXX_DEBUG -D_GLIBCXX_ASSERTIONS -fstack-protector-all -Wl,--stack=268435456 -o \"$file_base_name-dbg.exe\" \"$file\" && \"$file_base_name-dbg.exe\" < input.txt" },
            "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" debug \"$file\"" },
            "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" debug \"$file\"" }
        },
        {
            "name": "Run in terminal (interactive)",
            "windows": { "shell_cmd": "g++ -std=gnu++20 -O2 -DLOCAL -Wl,--stack=268435456 -o \"$file_base_name.exe\" \"$file\" && start \"CP\" cmd /c \"\"$file_base_name.exe\" & echo. & pause\"" },
            "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" terminal \"$file\"" },
            "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" terminal \"$file\"" }
        },
        {
            "name": "Run (timed)",
            "windows": { "shell_cmd": "g++ -std=gnu++20 -O2 -DLOCAL -Wl,--stack=268435456 -o \"$file_base_name.exe\" \"$file\" && powershell -Command \"$t=Measure-Command { Get-Content input.txt | ./$file_base_name.exe | Out-Host }; Write-Host ('--- ' + $t.TotalMilliseconds + ' ms')\"" },
            "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" timed \"$file\"" },
            "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" timed \"$file\"" }
        },
        {
            "name": "Run (output.txt)",
            "windows": { "shell_cmd": "g++ -std=gnu++20 -O2 -DLOCAL -Wl,--stack=268435456 -o \"$file_base_name.exe\" \"$file\" && \"$file_base_name.exe\" < input.txt > output.txt && type output.txt" },
            "linux": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" output \"$file\"" },
            "osx": { "shell_cmd": "\"$packages/User/../../scripts/run.sh\" output \"$file\"" }
        }
    ]
}
